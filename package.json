{
  "name": "@adonisjs/limiter",
  "description": "Rate limiting package for AdonisJS framework",
  "version": "3.1.0",
  "type": "module",
  "files": [
    "build",
    "!build/bin",
    "!build/tests"
  ],
  "exports": {
    ".": "./build/index.js",
    "./limiter_provider": "./build/providers/limiter_provider.js",
    "./services/main": "./build/services/main.js",
    "./stores/*": "./build/src/stores/*.js",
    "./types": "./build/src/types.js"
  },
  "scripts": {
    "pretest": "npm run lint",
    "test": "npm run test:pg && npm run test:mysql && npm run test:sqlite && mkdir coverage/tmp && cp -r coverage/*/tmp/. coverage/tmp",
    "test:pg": "cross-env DB=pg --reporter=json --report-dir=coverage/pg npm run quick:test",
    "test:mysql": "cross-env DB=mysql --reporter=json --report-dir=coverage/mysql npm run quick:test",
    "test:sqlite": "cross-env DB=sqlite --reporter=json --report-dir=coverage/sqlite npm run quick:test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "clean": "del-cli build",
    "precompile": "npm run lint && npm run clean",
    "copy:templates": "copyfiles \"stubs/**/*.stub\" --up=\"1\" build",
    "compile": "tsup-node && tsc --emitDeclarationOnly --declaration",
    "postcompile": "npm run copy:templates",
    "build": "npm run compile",
    "docs": "typedoc",
    "version": "npm run build",
    "prepublishOnly": "npm run build",
    "release": "release-it",
    "quick:test": "cross-env NODE_DEBUG=adonisjs:limiter node --import=@poppinss/ts-exec --enable-source-maps bin/test.ts"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.6.0",
    "@adonisjs/core": "^7.7.0",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/i18n": "^3.0.1",
    "@adonisjs/lucid": "^22.5.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/redis": "^11.0.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/expect-type": "^2.0.4",
    "@japa/file-system": "^3.0.0",
    "@japa/runner": "^5.4.0",
    "@libsql/sqlite3": "^0.3.1",
    "@poppinss/ts-exec": "^1.5.2",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "^26.6.11",
    "@types/sinon": "^22.0.2",
    "better-sqlite3": "^13.2.0",
    "c8": "^12.0.0",
    "copyfiles": "^2.4.1",
    "cross-env": "^10.1.0",
    "del-cli": "^8.0.1",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "luxon": "^3.7.2",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "prettier": "^3.10.1",
    "release-it": "^21.1.3",
    "sinon": "^22.1.0",
    "timekeeper": "^2.3.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "rate-limiter-flexible": "^11.6.1"
  },
  "peerDependencies": {
    "@adonisjs/assembler": "^8.0.0-next.9 || ^8.0.0",
    "@adonisjs/core": "^7.0.0-next.1 || ^7.0.0",
    "@adonisjs/i18n": "^3.0.0-next.0 || ^3.0.0",
    "@adonisjs/lucid": "^22.0.0-next.0 || ^22.0.0",
    "@adonisjs/redis": "^10.0.0-next.1 || ^10.0.0 || ^11.0.0"
  },
  "peerDependenciesMeta": {
    "@adonisjs/assembler": {
      "optional": true
    },
    "@adonisjs/lucid": {
      "optional": true
    },
    "@adonisjs/i18n": {
      "optional": true
    },
    "@adonisjs/redis": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adonisjs/limiter.git"
  },
  "homepage": "https://github.com/adonisjs/limiter#readme",
  "bugs": {
    "url": "https://github.com/adonisjs/limiter/issues"
  },
  "keywords": [
    "adonis",
    "rate-limiter"
  ],
  "author": "Harminder Virk <virk@adonisjs.com>",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "tsup": {
    "entry": [
      "./index.ts",
      "./providers/limiter_provider.ts",
      "./services/main.ts",
      "./src/stores/*.ts",
      "./src/types.ts"
    ],
    "outDir": "./build",
    "clean": true,
    "format": "esm",
    "dts": false,
    "sourcemap": false,
    "target": "esnext"
  },
  "release-it": {
    "git": {
      "requireCleanWorkingDir": true,
      "requireUpstream": true,
      "commitMessage": "chore(release): ${version}",
      "tagAnnotation": "v${version}",
      "push": true,
      "tagName": "v${version}"
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": true,
      "skipChecks": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**"
    ]
  },
  "prettier": "@adonisjs/prettier-config"
}
